{
	"name": "@justask/core",
	"version": "0.1.0",
	"description": "Turns what a person types in plain language into an app's own state. Code finds the candidates, a provider model picks, code builds the result.",
	"keywords": [
		"natural-language",
		"react",
		"forms",
		"filters",
		"search",
		"jev"
	],
	"license": "MIT",
	"author": "Franklin Martinez (https://github.com/franklinmdev)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/franklinmdev/justask.git"
	},
	"homepage": "https://github.com/franklinmdev/justask#readme",
	"bugs": "https://github.com/franklinmdev/justask/issues",
	"type": "module",
	"packageManager": "pnpm@12.5.1",
	"engines": {
		"node": ">=22"
	},
	"exports": {
		".": {
			"justask-source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./react": {
			"justask-source": "./src/react/index.ts",
			"types": "./dist/react/index.d.ts",
			"default": "./dist/react/index.js"
		},
		"./jev": {
			"justask-source": "./src/jev/index.ts",
			"types": "./dist/jev/index.d.ts",
			"default": "./dist/jev/index.js"
		},
		"./eval": {
			"justask-source": "./src/eval/index.ts",
			"types": "./dist/eval/index.d.ts",
			"default": "./dist/eval/index.js"
		}
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"lint": "biome check",
		"format": "biome check --write",
		"demo": "vite --config demo/vite.config.ts",
		"demo:build": "vite build --config demo/vite.config.ts",
		"demo:worker": "pnpm demo:build && WRANGLER_BUILD_CONDITIONS=justask-source,workerd,worker,browser wrangler dev",
		"demo:deploy": "pnpm demo:build && WRANGLER_BUILD_CONDITIONS=justask-source,workerd,worker,browser wrangler deploy"
	},
	"peerDependencies": {
		"@typesafe-ai/sdk": "^0.6.0",
		"react": "^19.0.0"
	},
	"peerDependenciesMeta": {
		"@typesafe-ai/sdk": {
			"optional": true
		},
		"react": {
			"optional": true
		}
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@fontsource-variable/host-grotesk": "5.3.0",
		"@fontsource/fragment-mono": "5.3.0",
		"@testing-library/dom": "10.4.2",
		"@testing-library/react": "16.3.3",
		"@testing-library/user-event": "14.6.7",
		"@types/jsdom": "30.0.0",
		"@types/node": "^24.13.6",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@typesafe-ai/sdk": "0.6.0",
		"@vitejs/plugin-react": "6.1.1",
		"axe-core": "4.13.0",
		"jsdom": "30.0.1",
		"playwright": "1.63.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"typescript": "7.0.2",
		"vite": "8.3.0",
		"vitest": "5.0.1",
		"wrangler": "4.136.3"
	}
}
